#!/bin/bash

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

source_bash_files() {

    local file=''
    local i=''

    declare -r -a FILES_TO_SOURCE=(
        'bash_aliases'
        'bash_exports'
        'bash_functions'
        'bash_options'
        'bash_prompt'
        'bash.local'  # for local settings that should
                      # not be under version control
    )

    for i in ${!FILES_TO_SOURCE[*]}; do
        file="$HOME/.${FILES_TO_SOURCE[$i]}"
        [ -r "$file" ] && source "$file"
    done

}

source_bash_files
unset -f source_bash_files

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Use dotfiles specific executibles
PATH=~/projects/dotfiles/bin:$PATH

# Use locally-installed npm executables.
#
# NOTE: ./node_modules/.bin was deliberately removed - a relative directory on
# PATH means every directory you cd into can shadow your commands with its own
# binaries. Use `npx <cmd>` to run a project-local tool instead.
PATH=~/npm/bin:$PATH

# Node, via fnm (installed by install.sh into ~/.local/bin).
#
# Deliberately NOT `eval "$(fnm env)"`: that runs fnm on every shell start.
# This symlink follows whatever `fnm default <version>` points at, so the
# default node is on PATH for free. Run `fnm use <version>` in a shell when a
# project needs a different one - that shadows this entry for that shell only.
PATH=~/.local/share/fnm/aliases/default/bin:$PATH

PATH=~/.local/bin:$PATH
PATH=~/bin:$PATH

# TeX Live installs per-year into /usr/local/texlive/<year>/. Glob for it and
# keep the last match: globs expand in sorted order, so that's the newest year
# present, and this stops needing an edit every January.
#
# The 20* is deliberate - it skips the texmf-local/ directory that sits
# alongside the year directories. No process is forked, so this costs nothing
# at shell start. If nothing matches, texlive stays unset.
for _texlive in /usr/local/texlive/20*/; do :; done

if [ -d "${_texlive}bin/x86_64-linux" ]; then
    PATH="${_texlive}bin/x86_64-linux:$PATH"
    MANPATH="${_texlive}texmf-dist/doc/man:$MANPATH"
    INFOPATH="${_texlive}texmf-dist/doc/info:$INFOPATH"
fi
unset _texlive

# Every assignment above is a bare `PATH=`, which only stays exported because
# the parent shell already exported PATH. nvm.sh used to `export PATH` itself
# and quietly covered for that; with nvm gone, say it explicitly.
export PATH MANPATH INFOPATH

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# zoxide (installed by install.sh into ~/.local/bin, so this has to come
# after PATH is set). `z <partial-path>` jumps by frecency - same muscle
# memory as the z.sh it replaces, and the old ~/.z database was imported.
eval "$(zoxide init bash)"

# NOTE: git completion used to be a vendored copy sourced from bin/. Ubuntu's
# bash-completion package ships a current one at
# /usr/share/bash-completion/completions/git and loads it on demand via
# /etc/bash.bashrc, so nothing needs doing here.
