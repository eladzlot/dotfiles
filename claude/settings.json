{
  "model": "opus",
  "theme": "dark",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || aplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/message.oga 2>/dev/null || aplay /usr/share/sounds/freedesktop/stereo/message.oga 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "notify-send \"Claude Code\" \"Claude needs your attention\" 2>/dev/null || gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.Notify \"Claude Code\" 0 \"\" \"Claude Code\" \"Claude needs your attention\" \"[]\" \"{}\" 5000 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
