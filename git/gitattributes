# Normalize line endings on commit; let git detect what's binary.
* text=auto

# Formats git should never diff or line-ending-convert. Marking them keeps
# `git diff` from dumping binary noise and keeps text=auto from guessing.
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.doc  binary
*.docx binary
*.rtf  binary
*.odt  binary

# NOTE: the msysgit `diff=astextplain` lines that used to be here referenced a
# diff driver that only Git for Windows defines - on Linux git silently fell
# back to the default. The `./*.sublime-*` entries were dead too: gitattributes
# patterns don't take a leading ./, so they matched nothing.
