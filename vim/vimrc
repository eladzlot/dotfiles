" ----------------------------------------------------------------------
" | General Settings                                                   |
" ----------------------------------------------------------------------

set nocompatible               " Don't make vim vi-compatibile

syntax on                      " Enable syntax highlighting

if has('autocmd')
    filetype plugin indent on
    "           │     │    └──── Enable file type detection
    "           │     └───────── Enable loading of indent file
    "           └─────────────── Enable loading of plugin files
endif

set autoindent                 " Copy indent to the new line

set backspace=indent           " ┐
set backspace+=eol             " │ Allow `backspace`
set backspace+=start           " ┘ in insert mode

set nobackup                   " no backup files
set nowritebackup              " only in case you don't want a backup file while editing
set noswapfile                 " no swap files

" Persistent undo: undo history survives closing the file. The directory has
" existed (gitignored) since long before this was switched on.
" The trailing // makes vim encode the full path into the undofile name, so
" same-named files in different directories don't collide.
if has('persistent_undo')
    set undodir=~/.vim/undos//
    set undofile
endif

set cursorline                 " Highlight the current line
set encoding=utf-8 nobomb      " Use UTF-8 without BOM
set nowrap		               " Do not wrap lines

set tabstop=2                  " show existing tab with 2 spaces width
set shiftwidth=2               " when indenting with '>', use 2 spaces width
set expandtab                  " On pressing tab, insert 2 spaces

set hlsearch                   " Enable search highlighting
set ignorecase                 " Ignore case in search patterns
set incsearch                  " Highlight search pattern as
                               " it is being typed

" Use the system clipboard as the default register.
"
" unnamedplus only: that's the + register, X CLIPBOARD, what ctrl-c/ctrl-v
" use. Deliberately NOT 'unnamed', which is the * register - X PRIMARY, the
" select-with-the-mouse / middle-click-to-paste buffer. With unnamed set,
" every yank *and every delete* in vim overwrites whatever you last selected
" with the mouse. The two registers are the same clipboard on macOS, which is
" where that setting came from.
if has('unnamedplus')
    set clipboard=unnamedplus
else
    set clipboard=unnamed
endif

set mousehide                  " Hide mouse pointer while typing

set number                     " Show line number
set laststatus=2	           " Always show ruler

set visualbell                 " ┐
set noerrorbells               " │ Disable beeping and window flashing
set t_vb=                      " ┘ https://vim.wikia.com/wiki/Disable_beeping

" Terminal escape sequences that leak into other programs.
"
" t_fe/t_fd turn the terminal's focus reporting on/off. Vim enables it and
" does not disable it before shelling out, so a focus change while fzf is up
" sends it ESC-[-I, and fzf (which predates focus events) reads the trailing
" I as a keystroke - a stray "I" in the citation prompt. Never enable it.
let &t_fe = ""
let &t_fd = ""

" t_u7 asks the terminal to report the cursor position, for ambiguous-width
" detection. The reply ends in "R", which used to leak in and drop us into
" Replace mode on startup. We don't need the detection; ambiwidth is single.
"
" The leak itself came from mapping <esc> in normal mode, which is now gone
" (see Key Mappings). This is kept anyway: the detection buys us nothing here,
" and re-enabling it only re-opens a path for replies to arrive.
set t_u7=
set ambiwidth=single

set hidden 		               " Allow unsaved buffers in the background

set spelllang=en_us
nnoremap <C-l> [s1z=`]
inoremap <C-l> <c-g>u<Esc>[s1z=`]a<c-g>u

set wildignore+=.DS_Store
set wildignore+=*.jpg,*.jpeg,*.gif,*.png,*.gif,*.psd,*.o,*.obj,*.min.js
set wildignore+=*/bower_components/*,*/node_modules/*,*/.git/*
set wildignore+=*/smarty/*,*/vendor/*,*/.hg/*,*/.svn/*,*/.sass-cache/*,*/log/*,*/tmp/*,*/build/*,*/ckeditor/*,*/source_maps/*,*/dist/*

" prevent syntax hl on huge files
" (grouped so re-sourcing this file replaces the autocmd instead of stacking copies)
augroup huge_files
  autocmd!
  autocmd BufWinEnter * if line2byte(line("$") + 1) > 100000 | syntax clear | endif
augroup END

" ----------------------------------------------------------------------
" | Plugins                                                            |
" ----------------------------------------------------------------------

" Use vim-plug to manage the vim plugins
" https://github.com/junegunn/vim-plug

" Initialize Plug and specify the path
" where the plugins should be installed
call plug#begin('~/.vim/plugins')

    Plug 'vim-airline/vim-airline'
    Plug 'tomasr/molokai'
    Plug 'dense-analysis/ale'
    Plug 'pangloss/vim-javascript'
    Plug 'vim-pandoc/vim-pandoc'
    Plug 'vim-pandoc/vim-pandoc-syntax' 
    Plug 'eigenfoo/stan-vim'
    Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
    Plug 'junegunn/fzf.vim'

call plug#end()

" Plugin Configuration -------------------------------------------------------------

" Airline.vim {{{
let g:airline_powerline_fonts = 1

if !exists('g:airline_symbols')
  let g:airline_symbols = {}
endif

" unicode symbols
let g:airline_left_sep = '▶'
let g:airline_right_sep = '◀'
let g:airline_symbols.linenr = '¶'
let g:airline_symbols.branch = '⎇'
let g:airline_symbols.paste = '∥'
let g:airline_symbols.whitespace = 'Ξ'

let g:airline#extensions#tabline#buffer_nr_format = '%s '
let g:airline#extensions#tabline#buffer_nr_show = 1
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#fnamecollapse = 0
let g:airline#extensions#tabline#fnamemod = ':t'
" }}}

" ----------------------------------------------------------------------
" | Color Scheme                                                       |
" ----------------------------------------------------------------------

set t_Co=256                   " Enable full-color support

" 24-bit colour. molokai is written in exact values - #F92672, #E6DB74 - and
" without this vim picks the nearest cell of the 256-colour cube instead.
" Those cells all sit further out than the colours they stand in for: the
" red-pink of an error arrives as hot magenta (#FF00AF), and the gold of a
" warning washes out to near-white (#FFFFAF).
"
" This was tried once before and reverted, but that was a misdiagnosis: the
" file corruption blamed on it was really the <esc> mapping in the Key
" Mappings section, which is now gone. The mechanism was the one this file
" documents twice elsewhere - enabling termguicolors makes vim ask the
" terminal for its background colour (OSC 11), the reply begins with <esc>,
" the mapping fired, and the rest of the reply ran as normal-mode commands.
"
" Clearing t_RB and t_RF stops the queries being sent at all, so the replies
" cannot arrive however <esc> is bound later. Nothing is lost by it:
" 'background' is set explicitly just below, which is all the queries were
" for.
set t_RB=
set t_RF=

if has('termguicolors')
    set termguicolors
endif

set background=dark            " Use colors that look good
                               " on a dark background

" these are read by the colorscheme, so they must be set before it loads
let g:molokai_original = 0
" only matters when termguicolors is off - it improves the 256-colour
" approximations, which are no longer what gets drawn
let g:rehash256 = 1

colorscheme molokai            " Use custom color scheme

" ----------------------------------------------------------------------
" | Syntax checker						       |
" ----------------------------------------------------------------------

" ALE {{{
" Only run the linters named here, so ALE does not pick up whatever else it
" happens to find on PATH for a filetype.
" ALE aliases rmd -> r, but with ale_linters_explicit that only resolves the
" linter definition; the selection still comes from this dict, so rmd needs
" its own entry. Drop the rmd line if linting manuscripts turns out noisy.
let g:ale_linters_explicit = 1
let g:ale_linters = {
      \ 'javascript': ['eslint'],
      \ 'r':          ['lintr'],
      \ 'rmd':        ['lintr'],
      \ }

" ALE still passes lintr's with_defaults(), which lintr 3.x removed - the
" Rscript call then dies with "could not find function" and ALE silently
" reports nothing. linters_with_defaults() is the replacement.
let g:ale_r_lintr_options = 'linters_with_defaults()'

let g:ale_sign_error = '✗'
let g:ale_sign_warning = '⚠'

" Lint on save rather than on every keystroke - less noise while writing.
let g:ale_lint_on_text_changed = 'never'
let g:ale_lint_on_insert_leave = 0
let g:ale_lint_on_enter = 0

nnoremap <leader>an :ALENextWrap<CR>
nnoremap <leader>ap :ALEPreviousWrap<CR>
" }}}

" ----------------------------------------------------------------------
" | Pandoc                                                             |
" ----------------------------------------------------------------------
" we need to use exe in order to use env. variables in the path (there's an
" alternative using `let &g' but I can't get it to work
exe 'let g:pandoc#biblio#bibs=["'.$HOME.'/projects/zettlr/zotero.json"]'
" let g:pandoc#modules#disabled = ["folding"]
"let g:pandoc#completion#bib#mode = 'citeproc'
let g:pandoc#biblio#bib_extensions = ["json", "bib", "bibtex", "ris", "mods", "enl", "wos", "medline", "copac"]

" ----------------------------------------------------------------------
" | Key Mappings                                                       |
" ----------------------------------------------------------------------

" NOTE: a trailing " comment on a :map line becomes part of the mapped keys,
" so every comment in this section goes on its own line above the mapping.

let mapleader = ','			" Use a different mapleader (default is '\')

" Short cut for escape from insert mode
inoremap jj <ESC>

" Quick save
nnoremap <leader>s :w<CR>

" Buffer navigation
nnoremap <leader>bn :bnext<CR>
nnoremap <leader>bp :bprevious<CR>
nnoremap <leader>bd :bdelete<CR>

" Clear search highlighting.
"
" DO NOT map this to <esc> in normal mode. It was, and it corrupted files.
"
" A terminal sends special keys and query replies as escape sequences: a
" literal <esc> followed by more bytes. Mapping <esc> on its own makes vim
" match the mapping the moment the <esc> arrives, so the remaining bytes of
" the sequence are left behind and run as normal-mode commands. Observed:
"
"   - vim starting in Replace mode, from the "R" ending a cursor-position
"     report (this is why t_u7 is cleared in General Settings)
"   - a "c" left pending as the change operator, so the next key completed
"     it: j became cj, which replaced two lines with one empty line and
"     dropped into insert mode, and G became cG
"   - the first keypress after startup being swallowed
"
" Confirmed by testing in GNOME Terminal: identical config with this mapping
" removed behaves correctly.
nnoremap <leader>h :nohlsearch<CR>

" edit vimrc {{{
    " [,ve] Open .vimrc in a vertical split, [,vr] reload it
    nnoremap <leader>ve :vsp $MYVIMRC<CR>
    nnoremap <leader>vr :source $MYVIMRC<CR>
" }}}

nnoremap <C-P> :Files<CR>
" the trailing space below is deliberate: it leaves the cmdline open at `:Rg `
nnoremap <C-F> :Rg 

" Plain text to markdown
" <leader>x: Break after sentence-ending punctuation (.?!), incl. quotes (.", ?”, !’)
nnoremap <leader>x :s/\v([\.\?\!]['"\u201d\u2019]*)\s+/\1\r/g<CR>:noh<CR>

" ----------------------------------------------------------------------
" | Auto complete citations                                            |
" ----------------------------------------------------------------------
" Lives in vim/autoload/cite.vim, mapped per filetype in
" vim/ftplugin/{pandoc,rmd}.vim

" single line do and dp for diffget
nnoremap <silent> <leader>dp V:diffput<cr>
nnoremap <silent> <leader>dg V:diffget<cr>
