# Numerous always-ignore extensions
*.diff
*.err
*.orig
*.log
*.rej
*.swo
*.swp
*.zip
*.vi
*~
*.sass-cache

# OS or Editor folders
.tmp
.DS_Store
._*
Thumbs.db
.cache
.project
.settings
.tmproj
*.esproj
nbproject

# Sublime
*.sublime-project
*.sublime-workspace

# Komodo
*.komodoproject
.komodotools

# Folders to ignore
node_modules

# created by vim
# (~/.vim is a symlink to vim/vim, so most of what lands there is generated:
#  plugins are installed by vim-plug, plug.vim itself is re-downloaded by
#  os/install_vim_plugins.sh, and *.spl are compiled from the .add wordlists.
#  Hand-written config under vim/vim - autoload/, ftplugin/, spell/*.add - is
#  tracked.)
.netrwhist
vim/vim/plugins/
vim/vim/autoload/plug.vim
vim/vim/backups/
vim/vim/swaps/
vim/vim/undos/
vim/vim/spell/*.spl
